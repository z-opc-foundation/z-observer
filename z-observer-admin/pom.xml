<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-observer</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-observer-admin</artifactId>
    <name>z-observer-admin (Collector &amp; Query)</name>
    <description>Receiver, log/trace storage, metrics query adapter, rule engine, alert fan-out.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-observer-core</artifactId>
        </dependency>

        <!-- JsonUtil / JsonCursor：去 Jackson 后的报文读写 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- BOM 把 starter-logging 的 logback/slf4j 传递件摘成了 test 域，
                 结果 Spring 自己的日志走进 NOP logger，启动期的装配异常一条都看不见。
                 换成显式 log4j2 绑定，与 SDK 模块同一种日志栈 -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>

        <!-- 直接用 log4j2 而非 slf4j 门面：BOM 把 slf4j-api 压成 test 域，
             compile 域根本没有它。与 starter 模块保持同一种写法，
             免得同一个仓里两套日志门面互相看不见对方的日志 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <!-- Spring 内部（DispatcherServlet、Jackson、Tomcat）一律走 slf4j，
             摘掉 starter-logging 之后必须显式给一份门面 + log4j2 provider，
             否则整个容器层的日志全部静默丢弃 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- D1：采集 target 从 z-config naming 发现，不另造服务发现。
             provided：收端打包时由运行环境提供，接不上 naming 的部署方式不受影响 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-config-client</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 端到端测试要打的是真的 SDK 发送器（NettyEventSink），不是复刻一份协议实现。
             复刻的那份和真实现各改各的，协议漂移永远测不出来。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-observer-starter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.observer.admin.ObserverAdminApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
